# ===================================================
# Variables d'environnement - Portfolio Monorepo
# ===================================================

# --- GOOGLE DRIVE (Stockage & Affichage des projets) ---
# Clé API Google Cloud (avec Google Drive API activée)
GOOGLE_DRIVE_API_KEY=votre_cle_api_google_drive
# ID du dossier partagé Google Drive contenant les fichiers/images des projets
GOOGLE_DRIVE_FOLDER_ID=votre_id_dossier_google_drive
VITE_GOOGLE_DRIVE_FOLDER_ID=votre_id_dossier_google_drive

# --- BACKEND (Cloudflare Worker & Formulaire de Contact) ---
# Email de réception des messages
CONTACT_RECEIVER_EMAIL=votre-email@exemple.com
# Clé API Resend (optionnel, pour l'envoi d'emails réels)
RESEND_API_KEY=re_123456789abcdef
# Origine autorisée pour CORS (* pour tout autoriser ou URL précise en production)
ALLOWED_ORIGIN=*

# --- FRONTEND (React / Vite) ---
VITE_API_URL=/api
VITE_CONTACT_EMAIL=votre-email@exemple.com
VITE_GITHUB_URL=https://github.com/votre-profil
VITE_LINKEDIN_URL=https://linkedin.com/in/votre-profil
VITE_TWITTER_URL=https://twitter.com/votre-profil
