# Configuration Backend Cloudflare Worker / API

# Google Drive (pour récupérer les médias / projets dynamiquement)
GOOGLE_DRIVE_API_KEY=AIzaSy...
GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Contact Form & Notifications
CONTACT_RECEIVER_EMAIL=votre-email@exemple.com
RESEND_API_KEY=re_123456789...

# Sécurité CORS
ALLOWED_ORIGIN=*

# Anti-spam — Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# Laisser vide pour désactiver le CAPTCHA (honeypot + rate limiting restent actifs)
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Rate limiting KV — créer un namespace KV dans Cloudflare et le binder comme RATE_LIMIT_KV
# dans wrangler.toml : [[kv_namespaces]] binding = "RATE_LIMIT_KV" id = "..."
